// ProSolutions Inventario - Database Schema
//
// NOTA: la BD contiene objetos que este archivo no puede expresar (índices
// parciales "CashRegister_one_open" e "InventoryCount_one_open", CHECK
// constraints de 20260911000000 e índice GIN trigram idx_product_name_trgm).
// `prisma migrate dev` puede proponer borrarlos: revisa el SQL generado antes
// de aplicar (usa --create-only).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

// Tipo de negocio elegido al registrarse. No restringe módulos (todo tenant
// conserva caja/POS/inventario); cambia el onboarding, el aterrizaje sugerido
// y qué opciones de canal se ofrecen:
//   FULL    → taller + venta de refacciones (default)
//   REPAIR  → solo taller de reparación
//   PARTNER → captador: manda equipos a un taller asociado (modelo "Telcel")
//   PARTS   → solo venta de refacciones, sin taller
enum BusinessKind {
  FULL
  REPAIR
  PARTNER
  PARTS
}

model Business {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  category            String               @default("electronics-repair")
  businessKind        BusinessKind         @default(FULL)
  phone               String?
  address             String?
  logoUrl             String?
  isActive            Boolean              @default(true)
  showInDirectory     Boolean              @default(true) // Aparecer en el directorio público /mercado
  lat                 Float?               // Ubicación para el mapa del directorio
  lng                 Float?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  users               User[]
  brands              Brand[]
  models              Model[]
  categories          Category[]
  products            Product[]
  priceHistory        PriceHistory[]
  productModels       ProductModel[]
  reservations        Reservation[]
  creditMovements     CreditMovement[]
  settings            Settings[]
  pushSubscriptions   PushSubscription[]
  cashRegisters       CashRegister[]
  cashMovements       CashMovement[]
  systemSettings      SystemSettings[]
  businessOperations  BusinessOperation[]
  branches            Branch[]
  branchStocks        BranchStock[]
  sales               Sale[]
  saleItems           SaleItem[]
  payments            Payment[]
  repairOrders        RepairOrder[]
  // Órdenes que este negocio captó para que las repare otro tenant
  // (modelo taller asociado: Telcel trae el equipo, el taller lo repara).
  originOrders        RepairOrder[]       @relation("OriginOrders")
  repairParts         RepairPart[]
  repairEvents        RepairEvent[]
  cashRequests        CashRequest[]
  repairPhotos        RepairPhoto[]
  workshopServices    WorkshopService[]
  marketplaceRequests MarketplaceRequest[]
  inventoryMovements  InventoryMovement[]
  suppliers           Supplier[]
  purchases           Purchase[]
  purchaseItems       PurchaseItem[]
  supplierPayments    SupplierPayment[]
  inventoryCounts     InventoryCount[]
  inventoryCountItems InventoryCountItem[]
  directoryEvents     DirectoryEvent[]
  deviceModels        DeviceModel[]
  shoppingItems       ShoppingItem[]
  encargos            Encargo[]
  // Órdenes de OTROS tenants delegadas a este negocio como taller reparador.
  receivedDelegations RepairOrder[]       @relation("DelegatedToBusiness")
  verificationCodes   VerificationCode[]
  auditEvents         AuditEvent[]
  notifications       Notification[]

  @@index([isActive])
}

enum UserRole {
  ADMIN
  EMPLOYEE
  CUSTOMER
  WORKSHOP // Taller aliado: solo ve el mercado B2B y sus solicitudes
}

enum CustomerType {
  TECHNICIAN // Técnico de reparación
  STORE // Local de venta de refacciones
  NORMAL // Cliente particular
}

// Código OTP de verificación de contacto (correo o teléfono) emitido al
// registrarse. El código viaja por Telegram (deep-link al bot) o correo
// (Resend cuando está configurado); aquí solo vive el hash SHA-256.
enum VerificationChannel {
  EMAIL
  PHONE
  TELEGRAM
}

model VerificationCode {
  id         String              @id @default(cuid())
  businessId String?
  business   Business?           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifier String              // correo o teléfono que se verifica
  channel    VerificationChannel
  codeHash   String
  purpose    String              @default("SIGNUP")
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())

  @@index([identifier, purpose])
  @@index([userId])
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReservationStatus {
  PENDING // Esperando acción
  PENDING_PAYMENT // Esperando comprobante de pago (transferencia)
  DEPOSIT_VERIFIED // Depósito verificado por admin
  APPROVED // Aprobada y lista para recoger
  REJECTED // Rechazada por admin
  COMPLETED // Entregada al cliente
  CANCELLED // Cancelada por cliente
  EXPIRED // Expirada automáticamente
}

enum ReservationType {
  TEMPORARY // Reserva temporal sin pago (expira en X minutos)
  DEPOSIT // Reserva con depósito del 50% (expira en X horas si no se recoge)
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
  TRANSFER // salida en una sucursal + entrada espejo en otra (mismo movimiento con toBranchId)
}

model InventoryMovement {
  businessVersion Int      @default(0)
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  paymentMethod   String?
  customerId      String?
  reservationId   String?
  saleId          String?
  id              String   @id @default(cuid())

  type          MovementType
  quantity      Int
  previousStock Int
  newStock      Int
  reason        String?
  notes         String?

  unitPrice  Float?
  totalPrice Float?

  productId String
  userId    String?

  // Sucursal donde ocurrió el movimiento; en TRANSFER, toBranchId es el destino.
  branchId   String?
  branch     Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  toBranchId String?
  toBranch   Branch? @relation("TransferDestination", fields: [toBranchId], references: [id], onDelete: SetNull)

  relatedId String? // ID de movimiento relacionado (ej: devolución de una venta)
  related   InventoryMovement?  @relation("RelatedMovement", fields: [relatedId], references: [id])
  relatedTo InventoryMovement[] @relation("RelatedMovement")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
  @@index([relatedId])
  @@index([reservationId])
  @@index([branchId, createdAt])
  @@index([saleId])
  @@index([businessId])
}

model User {
  id                    String       @id @default(cuid())
  businessId            String
  business              Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  email                 String?      @unique // Opcional para permitir registro solo con teléfono
  telegramId            String?      @unique // ID de Telegram para usuarios del bot
  qrCode                String?      @unique // Código QR único para identificación en tienda
  password              String? // Opcional si solo se registra por Bot
  name                  String
  businessName          String? // Nombre del negocio (para STORE) o taller (para TECHNICIAN)
  phone                 String?      @unique // Único si se proporciona
  role                  UserRole     @default(CUSTOMER)
  isSuperAdmin          Boolean      @default(false)
  jobTitle              String? // Puesto visible del staff: "Técnico", "Recepción", "Dueño"…
  publicSlug            String?      @unique // Slug público del taller aliado: /t/<slug> y /<slug>/order-status
  quickPin              String? // Hash bcrypt del PIN de 4-6 dígitos para cambio rápido de usuario
  customerType          CustomerType @default(NORMAL)
  requestedCustomerType CustomerType @default(NORMAL) // Tipo solicitado al registrarse
  status                UserStatus   @default(PENDING)

  // Sucursal base del empleado (ventas/caja operan sobre ella); null en clientes.
  homeBranchId String?
  homeBranch   Branch? @relation("HomeBranch", fields: [homeBranchId], references: [id], onDelete: SetNull)

  // Restricciones de acceso del staff. Lista VACÍA = sin restricción (todos
  // los módulos/sucursales). allowedModules usa las claves de lib/access.ts
  // ("ventas", "caja", "taller", …); allowedBranchIds guarda Branch.id.
  allowedModules   String[] @default([])
  allowedBranchIds String[] @default([])

  // Metas de compra
  monthlyPurchaseGoal   Float? // Meta mensual de compra en pesos
  totalPurchases        Float     @default(0) // Total de compras acumuladas
  currentMonthPurchases Float     @default(0) // Compras del mes actual
  lastPurchaseReset     DateTime? // Último reinicio del contador mensual

  // Crédito (pago diferido)
  creditLimit   Float? // Límite en pesos; null = sin línea de crédito
  creditBalance Float  @default(0) // Saldo deudor actual (lo que debe el cliente)

  // Estado de cuenta público: el cliente consulta saldo/movimientos/apartados
  // con /cuenta/<statementToken> (link por WhatsApp, sin login). El token es
  // la frontera de seguridad — se rota al reenviar y caduca a los 30 días.
  statementToken          String?   @unique
  statementTokenExpiresAt DateTime?

  assignedRepairs       RepairOrder[]        @relation("RepairAssignedTo")
  createdRepairs        RepairOrder[]        @relation("RepairCreatedBy")
  customerRepairs       RepairOrder[]        @relation("RepairCustomer")
  deliveredRepairs      RepairOrder[]        @relation("RepairDeliveredBy")
  repairParts           RepairPart[]         @relation("RepairPartCreatedBy")
  repairEvents          RepairEvent[]
  businessOperations    BusinessOperation[]
  reservations          Reservation[]
  movements             InventoryMovement[]
  creditMovements       CreditMovement[]
  priceChanges          PriceHistory[]       @relation("PriceChanges")
  cashRegistersOpened   CashRegister[]       @relation("RegisterOpenedBy")
  cashRegistersClosed   CashRegister[]       @relation("RegisterClosedBy")
  cashRequestsRequested CashRequest[]        @relation("CashRequestRequestedBy")
  cashRequestsDecided   CashRequest[]        @relation("CashRequestDecidedBy")
  repairPhotos          RepairPhoto[]
  repairPartsDecided    RepairPart[]         @relation("RepairPartDecidedBy")
  marketplaceRequested  MarketplaceRequest[] @relation("MarketplaceRequestedBy")
  marketplaceDecided    MarketplaceRequest[] @relation("MarketplaceDecidedBy")
  cashMovements         CashMovement[]
  salesMade             Sale[]               @relation("SaleSeller")
  salesAsCustomer       Sale[]               @relation("SaleCustomer")
  paymentsMade          Payment[]            @relation("PaymentCreatedBy")
  purchases             Purchase[]
  supplierPayments      SupplierPayment[]
  inventoryCounts       InventoryCount[]
  shoppingItemsCreated  ShoppingItem[]       @relation("ShoppingItemCreatedBy")
  shoppingItemsResolved ShoppingItem[]       @relation("ShoppingItemResolvedBy")
  encargosAsCustomer    Encargo[]            @relation("EncargoCustomer")
  encargosCreated       Encargo[]            @relation("EncargoCreatedBy")
  encargosResolved      Encargo[]            @relation("EncargoResolvedBy")
  verificationCodes     VerificationCode[]
  auditEvents           AuditEvent[]
  notificationReads     NotificationRead[]

  // Verificación de contacto al registrarse (código por correo/Telegram).
  // No bloquea el acceso: es una señal de confianza sobre la cuenta.
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

model Brand {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name       String
  slug       String
  logo       String?

  models Model[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
  @@unique([businessId, slug])
  @@index([businessId])
}

model Model {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name       String // Ej: "Galaxy S25 Ultra"
  slug       String
  brandId    String

  brand    Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  products ProductModel[] // Relación muchos a muchos con productos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, slug])
  @@index([name])
  @@index([businessId])
}

model Category {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name       String
  slug       String
  icon       String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
  @@unique([businessId, slug])
  @@index([businessId])
}

model Product {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name        String
  description String?
  barcode     String?

  retailPrice    Float // Precio público general
  wholesalePrice Float // Precio taller aliado (mercado B2B)
  internalPrice  Float? // Precio taller propio (pieza usada en orden de servicio propia; null = retailPrice)
  costPrice      Float? // Precio de costo (cuánto costó adquirirlo) — solo ADMIN

  stock    Int @default(0)
  minStock Int @default(1)

  // Anti-spam del aviso de stock bajo: cuándo se alertó por última vez.
  // Se limpia cuando el stock vuelve a subir por encima del mínimo.
  lowStockAlertAt DateTime?

  images String[] // Array de URLs

  isActive         Boolean @default(true)
  isUniversal      Boolean @default(false) // Producto universal (aparece en todos los modelos)
  // Quién puede ver el producto en el mercado: HIDDEN (nadie), ALLIES
  // (solo talleres aliados con cuenta), PUBLIC (también público general).
  marketVisibility String @default("HIDDEN")

  categoryId String

  // Relación muchos a muchos con modelos
  models   ProductModel[]
  category Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  reservations        Reservation[]
  movements           InventoryMovement[]
  priceHistory        PriceHistory[]
  stocks              BranchStock[]
  saleItems           SaleItem[]
  repairParts         RepairPart[]
  purchaseItems       PurchaseItem[]
  marketplaceRequests MarketplaceRequest[]
  inventoryCountItems InventoryCountItem[]
  shoppingItems       ShoppingItem[]
  encargos            Encargo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, barcode])
  @@index([categoryId])
  @@index([barcode])
  @@index([isUniversal])
  @@index([marketVisibility])
  @@index([businessId])
  @@index([businessId, isActive])
}

// Historial de cambios de precio
model PriceHistory {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productId   String
  field       String // "retailPrice", "wholesalePrice", "internalPrice", "costPrice"
  oldValue    Float
  newValue    Float
  changedById String?

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("PriceChanges", fields: [changedById], references: [id])

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([businessId])
}

// Tabla intermedia para relación muchos a muchos entre Product y Model
model ProductModel {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productId  String
  modelId    String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  model   Model   @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([productId, modelId])
  @@index([productId])
  @@index([modelId])
  @@index([businessId])
}

model Reservation {
  // 0 preserves legacy records; 1 uses transactional reservation accounting.
  businessVersion Int      @default(0)
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  id              String   @id @default(cuid())
  qrCode          String   @unique @default(cuid()) // Código QR único para verificación

  quantity      Int
  totalPrice    Float
  depositAmount Float? // Monto de anticipo (50% si aplica)
  depositPaid   Boolean @default(false)

  // Tipo de reserva
  type ReservationType @default(TEMPORARY) // TEMPORARY = sin pago, DEPOSIT = con anticipo

  status ReservationStatus @default(PENDING)

  paymentProofUrl String? // URL del comprobante de pago
  paymentMethod   String? // "transferencia", "oxxo", "efectivo"
  adminNotes      String?

  expiresAt DateTime // Fecha/hora de expiración de la reserva

  userId    String
  productId String

  // Sucursal que reserva/entrega la pieza. Las históricas quedan en null hasta conciliar.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([expiresAt])
  @@index([businessId])
  @@index([businessId, status])
}

// Movimientos de crédito (deuda y abonos)
enum CreditMovementType {
  REVERSAL // Reducción de deuda sin entrada de dinero
  DEBT // Venta/reserva a crédito → aumenta saldo deudor
  PAYMENT // Abono del cliente → disminuye saldo deudor
}

enum CreditReferenceType {
  RESERVATION
  SALE
  MANUAL
}

model CreditMovement {
  id            String               @id @default(cuid())
  businessId    String
  business      Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  amount        Float // Positivo = deuda, negativo = abono (siempre guardamos positivo y usamos type)
  type          CreditMovementType
  referenceType CreditReferenceType?
  referenceId   String? // ID de Reservation o InventoryMovement
  notes         String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([businessId])
  @@index([businessId, createdAt])
}

model Settings {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  // Configuración de reservas temporales (sin pago)
  tempReservationMinutes Int @default(30) // Minutos que dura una reserva temporal

  // Configuración de reservas con depósito
  depositPercentage       Int @default(50) // Porcentaje de anticipo requerido
  depositReservationHours Int @default(48) // Horas para recoger después de verificar depósito

  // Configuración de expiración pendiente de verificación
  pendingVerificationHours Int @default(24) // Horas para que admin verifique el depósito

  // Configuración de moneda
  exchangeRate Float @default(17.50) // Tipo de cambio MXN a USD

  updatedAt DateTime @updatedAt

  @@index([businessId])
}

model PushSubscription {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  endpoint   String   @unique
  keys       String // JSON stringified
  userId     String?

  createdAt DateTime @default(now())

  @@index([businessId])
}

model CashRegister {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  openedAt   DateTime  @default(now())
  closedAt   DateTime?

  initialAmount Float  @default(0) // Dinero en caja al abrir
  finalAmount   Float? // Dinero físico contado al cerrar

  status String @default("OPEN") // OPEN, CLOSED

  // Una caja por sucursal; las históricas quedan null hasta conciliar.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  openedById String
  openedBy   User   @relation("RegisterOpenedBy", fields: [openedById], references: [id])

  closedById String?
  closedBy   User?   @relation("RegisterClosedBy", fields: [closedById], references: [id])

  // Conteo físico al cerrar: {"1000":2,"500":5,…} denominación→piezas.
  // finalAmount sigue siendo el total contado (suma del desglose).
  denominations Json?

  notes String?

  movements CashMovement[]

  @@index([branchId, status])
  @@index([businessId])
}

enum CashMovementType {
  IN // Entrada de dinero (ventas, abonos)
  OUT // Salida de dinero (gastos, retiros, devoluciones)
}

model CashMovement {
  id          String           @id @default(cuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  amount      Float
  type        CashMovementType
  description String

  // Referencias a otros módulos (opcional)
  referenceType String? // Ej: "SALE", "RESERVATION", "CREDIT_PAYMENT", "EXPENSE"
  referenceId   String? // El ID del movimiento asociado

  registerId String
  register   CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)

  payment     Payment? // vínculo al pago documentado cuando aplica
  cashRequest CashRequest? // solicitud de gasto autorizada que originó este movimiento

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([registerId])
}

// Configuraciones del Sistema (Dólar, Tiempos, Banco)
model SystemSettings {
  id         Int      @id @default(autoincrement())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  key        String
  value      String
  type       String   @default("STRING") // STRING, NUMBER, JSON
  updatedAt  DateTime @updatedAt

  @@unique([businessId, key])
  @@index([businessId])
}

// Durable receipt for retries; never delete while its business records exist.
model BusinessOperation {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  key         String   @unique
  actorId     String
  kind        String
  requestHash String
  response    Json
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([businessId])
}

// Bitácora administrativa: quién cambió qué (precios, usuarios, ajustes,
// catálogos). Las operaciones de dinero/stock ya quedan en BusinessOperation
// y las de taller en RepairEvent; AuditEvent cubre las ediciones
// administrativas que antes no dejaban rastro (p. ej. un empleado bajando el
// precio que puso el dueño). `changes` guarda { campo: {before, after} } y
// NUNCA debe contener passwords, PINs, hashes ni tokens.
model AuditEvent {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String // "PRODUCT_UPDATE", "USER_UPDATE", "SETTINGS_UPDATE", ...
  entity     String // "product" | "user" | "settings" | "supplier" | "category" | "brand" | "model" | "branch" | "customer" | "business"
  entityId   String?
  entityName String? // nombre legible capturado al escribir ("Pantalla iPhone 11")
  summary    String // frase humana: "Precio $500.00 → $450.00"
  changes    Json? // { price: { before: 500, after: 450 }, ... }
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, actorId, createdAt])
}

// Workshop pilot: reception and custody only. Cash/stock remain separate until branch accounting is implemented.
enum RepairStatus {
  RECEIVED
  DIAGNOSIS
  WAITING_APPROVAL
  WAITING_PARTS
  IN_REPAIR
  QUALITY_CHECK
  READY
  DELIVERED
  CANCELLED
  NOT_REPAIRED // No quedó: irreparable, se devuelve al cliente
  NOT_AUTHORIZED // El cliente no autorizó el presupuesto
  EXTERNAL_LAB // Enviado a laboratorio/proveedor externo
  WARRANTY // Reingreso por garantía de una reparación previa
}

// Sucursal física del negocio (locales). El nombre de tabla se conserva por
// compatibilidad con el piloto de taller ya desplegado.
model Branch {
  id                String              @id @default(cuid())
  businessId        String
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name              String
  isActive          Boolean             @default(true)
  receivedOrders    RepairOrder[]       @relation("IntakeBranch")
  heldOrders        RepairOrder[]       @relation("CurrentBranch")
  sourceParts       RepairPart[]        @relation("PartSourceBranch")
  stocks            BranchStock[]
  cashRegisters     CashRegister[]
  sales             Sale[]
  homeStaff         User[]              @relation("HomeBranch")
  reservations      Reservation[]
  movements         InventoryMovement[]
  transfersReceived InventoryMovement[] @relation("TransferDestination")
  cashRequests      CashRequest[]
  purchases         Purchase[]
  inventoryCounts   InventoryCount[]
  encargos          Encargo[]
  createdAt         DateTime            @default(now())

  @@unique([businessId, name])
  @@index([businessId])
  @@map("WorkshopBranch")
}

// Existencias por sucursal. Product.stock queda como total cacheado para el
// catálogo; BranchStock es la fuente de verdad por local.
model BranchStock {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productId  String
  branchId   String
  quantity   Int      @default(0)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([productId, branchId])
  @@index([branchId, quantity])
  @@index([businessId])
}

// ==================== DOCUMENTO DE VENTA ====================

enum SaleStatus {
  DRAFT // documento vivo sin stock ni dinero: venta suspendida o cotización
  OPEN // apartado de mostrador: stock comprometido, saldo por liquidar/entregar
  COMPLETED
  VOIDED // anulada mediante contramovimientos; el documento se conserva
}

// Tipo de documento de la venta. RETAIL: mostrador al público. WORKSHOP:
// "Nota de venta a taller" — venta de refacciones a un taller/negocio
// (cliente tipo STORE o TECHNICIAN, precio de mayoreo). Separa la
// contabilidad del negocio de refacciones de la venta al público.
// LAYAWAY: apartado de mostrador multi-producto con anticipos parciales;
// QUOTE: cotización de mostrador con vigencia, convierte a venta sin
// mover stock mientras vive en DRAFT.
enum SaleKind {
  RETAIL
  WORKSHOP
  LAYAWAY
  QUOTE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
}

enum PaymentStatus {
  CONFIRMED
  PENDING_REVIEW // transferencia/depósito aún sin verificar
  REFUNDED
  VOIDED
}

model Sale {
  id                 String              @id @default(cuid())
  businessId         String
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  number             Int                 @unique @default(autoincrement())
  version            Int                 @default(1)
  status             SaleStatus          @default(COMPLETED)
  kind               SaleKind            @default(RETAIL)
  total              Float
  branchId           String
  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sellerId           String
  seller             User                @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  customerId         String?
  customer           User?               @relation("SaleCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  items              SaleItem[]
  payments           Payment[]
  marketplaceRequest MarketplaceRequest?
  // Documentos vivos: vigencia de cotización/apartado y nota interna del
  // mostrador ("cliente dijo que vuelve por el resto").
  expiresAt          DateTime?
  note               String?
  // Descuento autorizado al cobrar (checkout con descuento): centavos
  // descontados sobre el total de catálogo y el motivo capturado. El rastro
  // de quién vendió abajo del precio queda en la propia venta; total sigue
  // siendo el importe de catálogo y lo cobrado es total − discountCents.
  discountCents      Int                 @default(0)
  discountReason     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([branchId, createdAt])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([sellerId])
}

model SaleItem {
  id               String   @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  saleId           String
  sale             Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity         Int
  returnedQuantity Int      @default(0)
  unitPrice        Float
  totalPrice       Float

  @@index([saleId])
  @@index([productId])
  @@index([businessId])
}

// Pago cobrado: una venta puede pagarse en varios medios (p. ej. parte efectivo
// y parte tarjeta). CREDIT no genera efectivo: crea cuenta por cobrar.
model Payment {
  id             String        @id @default(cuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  saleId         String?
  sale           Sale?         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  // Cobros de taller: anticipo (ADVANCE), abono (ABONO) o liquidación (SETTLEMENT).
  repairOrderId  String?
  repairOrder    RepairOrder?  @relation(fields: [repairOrderId], references: [id], onDelete: Restrict)
  purpose        String?
  method         PaymentMethod
  amount         Float
  status         PaymentStatus @default(CONFIRMED)
  proofUrl       String? // comprobante privado cuando aplica
  reference      String? // folio/autorización de la terminal o SPEI
  cashMovementId String?       @unique // asiento de caja cuando method = CASH
  cashMovement   CashMovement? @relation(fields: [cashMovementId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User          @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  notes          String?
  createdAt      DateTime      @default(now())

  @@index([saleId])
  @@index([repairOrderId])
  @@index([method, createdAt])
  @@index([businessId])
}

model RepairOrder {
  id                   String        @id @default(cuid())
  businessId           String
  business             Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  number               Int           @unique @default(autoincrement())
  version              Int           @default(1)
  status               RepairStatus  @default(RECEIVED)
  customerName         String
  customerPhone        String
  // Segundo contacto opcional (familiar, trabajo, otro responsable).
  customerPhoneAlt     String?
  customerId           String?
  customer             User?          @relation("RepairCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  equipmentType        String
  brand                String?
  model                String?
  serialNumber         String?
  equipmentColor       String?
  accessories          String?
  // NONE | PATTERN | PIN | PASSWORD — deviceAccessValue se considera dato sensible
  deviceAccessType     String?
  deviceAccessValue    String?
  intakeCondition      String?
  // Condiciones funcionales (flags separados por coma: ENCENDIDO,APAGADO,MOJADO,
  // MANIPULADO,ROTO,INCOMPLETO) y estética cosmética (BUENO | REGULAR | MALO).
  functionalConditions String?
  aesthetics           String?
  // Anaquel/mesa/caja donde quedó físicamente el equipo.
  location             String?
  // Agenda del técnico: distinta de la fecha prometida al cliente.
  scheduledAt          DateTime?
  reportedIssue        String
  // Servicio elegido del catálogo al recibir (opcional; el texto libre va en reportedIssue).
  serviceName          String?
  diagnosis            String?
  // quoteCents/approvedQuoteCents son SOLO mano de obra; las RepairPart
  // aprobadas se cobran además.
  quoteCents           Int?
  approvedQuoteCents   Int?
  quoteApprovedAt      DateTime?
  // Cargo por diagnóstico/revisión cobrado al entregar sin reparación
  // (NOT_AUTHORIZED / NOT_REPAIRED): la cotización rechazada no se cobra.
  diagnosticFeeCents   Int?
  // La orden se entregó sin reparación: tras DELIVERED el status se pierde,
  // esta marca conserva que el cobro real fue solo el diagnóstico.
  closedWithoutRepair  Boolean       @default(false)
  qualityCheck         String?
  // Entrega estructurada: deliveredTo = nombre de quien recoge,
  // deliveredToDoc = identificación opcional (INE/licencia), firma aparte
  // de la de recepción y staff que entregó (auditoría de mostrador).
  deliveredTo          String?
  deliveredToDoc       String?
  deliverySignatureData String?
  deliveredById        String?
  deliveredBy          User?         @relation("RepairDeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict)
  promisedAt           DateTime?
  // Firma del cliente al recibir (PNG base64). Autorización de condiciones.
  signatureData        String?
  // Vigencia real de la cotización pública (el documento dice 15 días):
  // se fija al presentar la cotización con la acción QUOTE.
  quoteExpiresAt       DateTime?
  // Garantía con vigencia: al reabrir una orden entregada por garantía se
  // fija la fecha límite (días configurables por negocio, default 30) y se
  // cuenta cuántas veces ha entrado a garantía.
  warrantyUntil        DateTime?
  warrantyCount        Int            @default(0)
  // Taller aliado que captó el equipo (modelo "Telcel trae → nosotros
  // reparamos"): originBusinessId liga el tenant cuando está registrado y
  // originBusinessName queda como texto cuando no lo está. partnerPriceCents
  // es el precio convenio que se cobra al aliado (no al cliente final).
  originBusinessId     String?
  originBusiness       Business?      @relation("OriginOrders", fields: [originBusinessId], references: [id], onDelete: SetNull)
  originBusinessName   String?
  originContact        String?
  partnerPriceCents    Int?
  // Delegación saliente: esta orden fue enviada a un taller asociado externo
  // (el negocio captador crea la orden local y luego la asigna al reparador).
  // La orden local queda en EXTERNAL_LAB como referencia; el trabajo vive en
  // la orden espejo del tenant reparador (delegatedOrderId). El cobro al
  // cliente final es una venta POS aparte — la reparación no se mezcla.
  delegatedToBusinessId String?
  delegatedToBusiness   Business?      @relation("DelegatedToBusiness", fields: [delegatedToBusinessId], references: [id], onDelete: SetNull)
  delegatedOrderId      String?
  delegatedAt           DateTime?
  // En la orden espejo del tenant reparador: id de la orden local que la
  // originó. Sirve para hacer la delegación idempotente (si la marca local
  // falló tras crear la espejo, el reintento la reconoce).
  delegatedFromOrderId  String?
  // Cuenta interna del convenio B2B saldada. Semántica local simétrica: en
  // la orden ORIGEN (delegatedOrderId) marca "ya le pagué al taller"; en la
  // ESPEJO (originBusinessId/delegatedFromOrderId) marca "el captador ya me
  // pagó". Es solo control entre negocios — el cobro al cliente va por POS.
  convenioSettledAt     DateTime?
  // Token público para subir evidencias por QR sin login (se puede rotar).
  uploadToken          String        @unique @default(cuid())
  uploadTokenExpiresAt DateTime?
  quoteToken           String        @unique @default(cuid()) // Token público para ver/aprobar la cotización
  quoteTokenExpiresAt  DateTime?
  photos               RepairPhoto[]
  intakeBranchId       String
  currentBranchId      String
  intakeBranch         Branch        @relation("IntakeBranch", fields: [intakeBranchId], references: [id], onDelete: Restrict)
  currentBranch        Branch        @relation("CurrentBranch", fields: [currentBranchId], references: [id], onDelete: Restrict)
  assignedToId         String?
  assignedTo           User?         @relation("RepairAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdById          String
  createdBy            User          @relation("RepairCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  events               RepairEvent[]
  parts                RepairPart[]
  payments             Payment[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([currentBranchId, status, createdAt])
  @@index([assignedToId, status])
  @@index([customerPhone])
  @@index([customerId])
  @@index([businessId])
  @@index([intakeBranchId])
  @@index([originBusinessId])
  @@index([delegatedToBusinessId])
  @@index([delegatedFromOrderId])
}

// Refacción o insumo registrado contra una orden de reparación.
model RepairPart {
  id             String      @id @default(cuid())
  businessId     String
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  orderId        String
  order          RepairOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId      String?
  product        Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  description    String
  qty            Int         @default(1)
  unitCostCents  Int         @default(0)
  unitPriceCents Int         @default(0)
  createdById    String
  createdBy      User        @relation("RepairPartCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  // REQUESTED = pedida por técnico pendiente de autorización; APPROVED/REJECTED.
  status         PartStatus  @default(APPROVED)
  // Sucursal de donde salió físicamente la pieza (default: la sucursal
  // actual de la orden). Permite que un almacén de refacciones surta a los
  // talleres sin mover la orden de sucursal.
  sourceBranchId String?
  sourceBranch   Branch?     @relation("PartSourceBranch", fields: [sourceBranchId], references: [id], onDelete: SetNull)
  decidedById    String?
  decidedBy      User?       @relation("RepairPartDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime    @default(now())

  @@index([orderId])
  @@index([status])
  @@index([businessId])
}

model RepairEvent {
  id         String      @id @default(cuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  orderId    String
  order      RepairOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorId    String
  actor      User        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  type       String
  detail     String
  // Notas visibles para el cliente en el rastreo público (solo type=NOTE).
  isPublic   Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([orderId, createdAt])
  @@index([businessId])
}

enum PartStatus {
  REQUESTED // Técnico la pidió; pendiente de autorización del admin
  APPROVED
  REJECTED
}

enum CashRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Gasto o salida de caja pedida por un empleado; al aprobarse genera su
// CashMovement OUT. El admin decide; el solicitante nunca se auto-aprueba.
model CashRequest {
  id             String            @id @default(cuid())
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branchId       String
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  amountCents    Int
  concept        String
  status         CashRequestStatus @default(PENDING)
  requestedById  String
  requestedBy    User              @relation("CashRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedById    String?
  decidedBy      User?             @relation("CashRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  decisionNote   String?
  cashMovementId String?           @unique
  cashMovement   CashMovement?     @relation(fields: [cashMovementId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@index([branchId, status])
  @@index([businessId])
}

// Evidencia fotográfica de una orden (estado al recibir, avance, resultado).
// filePath es relativo al almacenamiento local; se sirve por /api/evidence.
model RepairPhoto {
  id           String      @id @default(cuid())
  businessId   String
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  orderId      String
  order        RepairOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  filePath     String
  label        String?
  uploadedById String?
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([orderId])
  @@index([businessId])
}

// Catálogo de modelos de equipo para autocompletar al recibir
// (ej. brand=Samsung, model=Galaxy A21, code=SM-A245M).
model DeviceModel {
  id         String    @id @default(cuid())
  // null = catálogo global de plataforma (solo superadmin escribe);
  // con valor = modelo privado del tenant (staff lo da de alta al vuelo).
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  brand      String
  model      String
  code       String?
  type       String    @default("SMARTPHONE")
  createdAt  DateTime  @default(now())

  // Dedup por tenant. Las filas globales (businessId NULL) NO deduplican con
  // este índice (NULL != NULL en Postgres) — la migración agrega un índice
  // único parcial WHERE "businessId" IS NULL para ellas.
  @@unique([businessId, brand, model])
  @@index([businessId])
  @@index([brand])

  servicePrices WorkshopServicePrice[]
}

// Catálogo de servicios del taller (cambio de pantalla, liberación, etc.) con
// precio sugerido; se usa como autocomplete al recibir equipos.
model WorkshopService {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name          String
  description   String?
  // null = el precio depende del dispositivo; se cotiza al recibir.
  priceCents    Int?
  equipmentType String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Precios específicos por modelo/tipo de equipo: ganan sobre priceCents.
  prices        WorkshopServicePrice[]

  @@index([isActive, name])
  @@index([businessId])
}

// Precio de un servicio para un dispositivo concreto: "reemplazo de pantalla
// iPhone 7 = $800" vs el precio base del servicio. Se resuelve al recibir:
// precio del modelo exacto > precio del tipo de equipo > priceCents base.
// Los dedup viven en índices únicos parciales de la migración (NULL != NULL).
model WorkshopServicePrice {
  id            String          @id @default(cuid())
  serviceId     String
  service       WorkshopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  // Uno de los dos alcances, nunca ambos:
  deviceModelId String? // modelo exacto del catálogo (marca+modelo)
  deviceModel   DeviceModel?    @relation(fields: [deviceModelId], references: [id], onDelete: Cascade)
  equipmentType String? // tipo de equipo genérico ("Laptop", "Consola")
  priceCents    Int
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([deviceModelId])
  @@index([serviceId])
}

model MarketplaceRequest {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product       Product   @relation(fields: [productId], references: [id])
  productId     String
  qty           Int       @default(1)
  tallerName    String // Nombre del taller aliado que solicita
  contactName   String?
  contactPhone  String?
  note          String?
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED, FULFILLED
  requestedById String?
  requestedBy   User?     @relation("MarketplaceRequestedBy", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?     @relation("MarketplaceDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?
  saleId        String?   @unique // Venta generada al surtir la solicitud
  sale          Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@index([status])
  @@index([productId])
  @@index([businessId])
  @@index([requestedById])
  @@index([decidedById])
}

// ==================== COMPRAS / PROVEEDORES ====================

// Proveedor de refacciones. Los montos de compra se guardan en centavos.
model Supplier {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name       String
  phone      String?
  email      String?
  notes      String?
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  purchases  Purchase[]
  payments   SupplierPayment[]

  @@unique([businessId, name])
  @@index([businessId])
}

enum PurchaseStatus {
  DRAFT // Borrador editable; aún no se pide al proveedor
  ORDERED // Pedida al proveedor, en espera de entrega
  RECEIVED // Recibida: el stock ya entró a la sucursal
  CANCELLED
}

// Orden de compra. Al pasar a RECEIVED genera los movimientos IN de inventario
// sobre purchase.branchId (mismo efecto que moveInventory type IN).
model Purchase {
  id               String            @id @default(cuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  // Folio visible OC-000001, por negocio: el dominio asigna MAX(number) del
  // tenant + 1 dentro de la tx serializable; el autoincrement queda inerte.
  number           Int               @default(autoincrement())
  supplierId       String?
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status           PurchaseStatus    @default(DRAFT)
  branchId         String
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  notes            String?
  totalCents       Int               @default(0) // suma de items, calculado en servidor
  // Abonos ligados a ESTA orden (cache por OC; la deuda del proveedor se deriva
  // de sum(RECEIVED.totalCents) - sum(SupplierPayment.amountCents)).
  paidCents        Int               @default(0)
  dueAt            DateTime? // fecha promesa de pago al proveedor
  paidAt           DateTime? // cuándo quedó liquidada (paidCents >= totalCents)
  items            PurchaseItem[]
  supplierPayments SupplierPayment[]
  shoppingItems    ShoppingItem[]
  createdById      String
  createdBy        User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  receivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([businessId, createdAt])
}

model PurchaseItem {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  purchaseId    String
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Int
  // Unidades ya recibidas de esta línea (recepción parcial). La OC queda
  // ORDERED mientras receivedQty < quantity en alguna línea.
  receivedQty   Int      @default(0)
  unitCostCents Int

  @@index([purchaseId])
  @@index([businessId])
}

// Abono del negocio a un proveedor (cuentas por pagar). Puede ligarse a una OC
// en estado ORDERED|RECEIVED o quedar a cuenta general (purchaseId null).
// NO genera CashMovement: el pago a proveedores es dinero externo (transferencia
// bancaria, efectivo entregado fuera de mostrador), no sale de la caja del local.
model SupplierPayment {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseId  String?
  purchase    Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  amountCents Int
  method      String // "CASH" | "CARD" | "TRANSFER" (solo documenta el medio usado)
  notes       String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())

  @@index([businessId])
  @@index([supplierId])
  @@index([purchaseId])
}

// ==================== CONTEO FÍSICO ====================

enum CountStatus {
  OPEN // Captura en curso; editable hasta aplicar o cancelar
  APPLIED // Ajustes aplicados: cada diferencia quedó como InventoryMovement ADJUSTMENT
  CANCELLED
}

// Sesión de conteo físico por sucursal: se captura lo que realmente hay y al
// aplicar se generan los ajustes auditados contra el stock registrado.
// Solo una OPEN por sucursal a la vez: la BD tiene el índice único parcial
// "InventoryCount_one_open" (no expresable en este archivo, como
// "CashRegister_one_open"); el dominio también lo valida.
model InventoryCount {
  id          String               @id @default(cuid())
  businessId  String
  business    Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  // Folio visible CC-000001, por negocio: el dominio asigna MAX(number) del
  // tenant + 1 dentro de la tx serializable; el autoincrement queda inerte.
  number      Int                  @default(autoincrement())
  branchId    String
  branch      Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  status      CountStatus          @default(OPEN)
  // Conteo ciego: el capturador no ve expectedQty hasta que el conteo se aplica.
  blind       Boolean              @default(false)
  notes       String?
  createdById String
  createdBy   User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  appliedAt   DateTime?
  createdAt   DateTime             @default(now())
  items       InventoryCountItem[]

  @@unique([businessId, number])
  @@index([businessId, status])
}

// Producto capturado dentro de una sesión de conteo. expectedQty es lo que el
// sistema tenía registrado (BranchStock) al capturar; si el stock se mueve
// antes de aplicar, se re-sincroniza al aplicar para que el ajuste registrado
// siempre sea countedQty - expectedQty.
model InventoryCountItem {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  countId     String
  count       InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  expectedQty Int
  countedQty  Int

  @@unique([countId, productId])
  @@index([businessId])
}

// Solicitud de refacción del directorio público: un visitante de /mercado
// pide algo que ningún negocio tiene publicado. Es dato a nivel plataforma
// (compartido entre tenants que participan en el mercado).
enum PartRequestStatus {
  OPEN
  CONTACTED
  CLOSED
}

model PartRequest {
  id        String            @id @default(cuid())
  name      String // Qué refacción/equipo busca el visitante
  detail    String?
  phone     String // WhatsApp del interesado para que el negocio lo contacte
  status    PartRequestStatus @default(OPEN)
  createdAt DateTime          @default(now())

  @@index([status, createdAt])
}

// ==================== LISTA DE ENCARGOS / COMPRAS ====================

enum ShoppingItemStatus {
  PENDING // Falta por comprar
  PURCHASED // Ya se compró (manual o por OC recibida)
  CANCELLED
}

// Entrada manual de la "lista de encargos": insumos que no son producto del
// catálogo (alcohol, cinta, herramientas) o productos que sí lo son. La
// demanda de REFACCIONES por órdenes abiertas no se persiste aquí — se
// calcula en vivo desde RepairPart + stock, así nunca queda desactualizada.
model ShoppingItem {
  id          String            @id @default(cuid())
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productId   String?
  product     Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String // Qué hay que comprar (texto libre o nombre del producto)
  quantity    Int               @default(1)
  // Costo estimado opcional por pieza, para presupuestar la compra.
  unitCostCents Int             @default(0)
  status      ShoppingItemStatus @default(PENDING)
  notes       String?
  // OC que cubre este pendiente (si se generó desde la lista).
  purchaseId  String?
  purchase    Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User              @relation("ShoppingItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  resolvedById String?
  resolvedBy  User?             @relation("ShoppingItemResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([businessId, status])
}

// ==================== ENCARGOS DE CLIENTES ====================

// Pieza que un cliente pide y el negocio NO tiene en stock ("encargo de
// mostrador"). Flujo: PENDING (registrado) → ORDERED (pedida a proveedor o a
// un aliado del mercado) → READY (llegó; se avisa al staff para entregar) →
// DELIVERED. CANCELLED se alcanza desde cualquier estado.
// `marketplaceRequestId` liga con la solicitud al aliado cuando la pieza se
// pidió por el mercado B2B; `supplierNote` deja constancia de a quién se pidió.
model Encargo {
  id                   String    @id @default(cuid())
  businessId           String
  business             Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  // Sucursal que registró el encargo y donde se entrega la pieza.
  branchId             String?
  branch               Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  // Cliente que encargó (User con role CUSTOMER); null = encargo sin cuenta.
  customerId           String?
  customer             User?     @relation("EncargoCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  // Pieza del catálogo propio cuando ya existe; null si es texto libre.
  productId            String?
  product              Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  description          String // Qué pieza busca el cliente (texto libre)
  quantity             Int       @default(1)
  deposit              Float     @default(0) // Anticipo en pesos que dejó el cliente
  // Precio en pesos cotizado al cliente al tomar el encargo; null = aún sin cotizar.
  priceQuoted          Float?
  status               String    @default("PENDING") // PENDING, ORDERED, READY, DELIVERED, CANCELLED
  supplierNote         String?
  marketplaceRequestId String?
  createdById          String?
  createdBy            User?     @relation("EncargoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedById         String?
  resolvedBy           User?     @relation("EncargoResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

// Telemetría del directorio: búsquedas, clicks a vitrinas y solicitudes.
// Alimenta el panel de /platform (inteligencia de mercado).
model DirectoryEvent {
  id         String    @id @default(cuid())
  kind       String // "search" | "click" | "request"
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  query      String? // Término buscado o categoría filtrada
  createdAt  DateTime  @default(now())

  @@index([kind, createdAt])
  @@index([businessId])
}

// ==================== NOTIFICACIONES IN-APP ====================

// Notificación persistente del staff (antes: SSE efímero + localStorage, se
// perdía al cambiar de dispositivo). Una fila por evento y negocio; la
// audiencia replica el Set de roles del broadcast SSE:
//   "ADMIN" → solo admins (sendNotificationToAdmins, roles={ADMIN})
//   "STAFF" → admin + empleados (sendNotificationToStaff, roles={ADMIN,EMPLOYEE})
// `data` guarda solo lo necesario para enlazar (ids, folios): el broadcast
// depura claves con PII/secretos (email, phone, token, firma…) antes de
// persistir; el payload SSE en vivo se mantiene intacto.
model Notification {
  id         String             @id @default(cuid())
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String // NotificationType del stream: new_reservation, low_stock, ...
  audience   String // "ADMIN" | "STAFF"
  title      String
  message    String
  data       Json?
  createdAt  DateTime           @default(now())
  reads      NotificationRead[]

  @@index([businessId, createdAt])
}

// Lectura POR usuario: una notificación del negocio la lee cada miembro del
// staff en su propio ritmo (el borrado es por cascada con la notificación o
// el usuario).
model NotificationRead {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([notificationId, userId])
  @@index([userId])
}

// Bitácora de la consola de plataforma (superadmin Reficio). Sin FK a
// Business/User a propósito: el evento debe sobrevivir al borrado del tenant
// y del operador — guarda snapshot legible (slug/nombre/email).
model PlatformEvent {
  id           String   @id @default(cuid())
  businessId   String
  businessSlug String
  businessName String
  kind         String // TENANT_SUSPENDED | TENANT_REACTIVATED | TENANT_DELETED
  actorId      String
  actorEmail   String?
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([createdAt])
}

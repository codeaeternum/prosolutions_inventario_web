FROM node:20-alpine

WORKDIR /app

# Install dependencies (full)
COPY package*.json ./
COPY prisma ./prisma
RUN npm ci
RUN npm install -g tsx typescript

# Copy source code (full)
COPY . .

# Generate Prisma Client
RUN npx prisma generate

# Command handled by docker-compose but default provided
CMD ["npm", "run", "bot:start"]

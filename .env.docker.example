# Variables para despliegue con docker compose (deploy-n5.ps1 / Portainer).
# NO es el .env de desarrollo: DATABASE_URL aquí apunta a la red interna (db).
# Copia a .env.docker y rellena los valores reales. .env.docker está en .gitignore.

# Base de datos interna del stack (host = nombre del servicio)
DATABASE_URL=postgresql://prosolutions:CAMBIAR@db:5432/prosolutions_db?schema=public
POSTGRES_PASSWORD=CAMBIAR

# Sesión / URL pública
NEXTAUTH_SECRET=CAMBIAR
NEXTAUTH_URL=https://reficio.app

# Cifrado de PIN/patrón de desbloqueo de equipos (AES-256-GCM).
# Generar con: openssl rand -hex 32
# Si se omite se deriva de NEXTAUTH_SECRET (funciona, pero una llave
# dedicada sobrevive a la rotación del secreto de sesión).
DEVICE_SECRET_KEY=

# Bot de Telegram
TELEGRAM_BOT_TOKEN=CAMBIAR
# Username público del bot (sin @) para los deep-links de verificación
# t.me/<bot>?start=verify_<código>. Si se omite se resuelve con getMe.
TELEGRAM_BOT_USERNAME=

# Correo transaccional (Resend) para códigos de verificación.
# Con RESEND_API_KEY activo, los negocios que se auto-registran en /registro
# nacen PENDING y se activan al verificar su correo (o su teléfono vía
# Telegram si capturaron uno). Sin la key, solo el canal Telegram puede
# activarlos — un alta sin teléfono ni key queda aprobada directo.
RESEND_API_KEY=
RESEND_FROM="Reficio <noreply@resend.dev>"

# Notificaciones push (opcional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@prosolutions.com

# Endpoint cron protegido (lo usa cualquier scheduler externo que llame a
# /api/cron/* y /api/reservations/check-expiring con Bearer)
CRON_SECRET=CAMBIAR

# Rate limiting tras proxy (fijado en "true" dentro de los compose de
# producción — no hace falta definirla en el .env). Solo activar cuando el
# origen es alcanzable EXCLUSIVAMENTE vía Cloudflare Tunnel: cloudflared
# sobrescribe CF-Connecting-IP y X-Forwarded-For con la IP real y el rate
# limit los usa para el bucket por cliente. Si el puerto 3005 queda expuesto
# directo a internet, un cliente puede forjar esos headers — en ese caso
# dejar en false (todos comparten un solo bucket "direct-clients").
TRUST_PROXY_HEADERS=true

# Orígenes extra permitidos para requests mutadores (defensa Origin del
# proxy, lista separada por comas). NEXTAUTH_URL siempre está permitido;
# añade aquí otros orígenes legítimos (p. ej. el dominio alterno del mismo
# negocio). Vacío = solo el propio host/NEXTAUTH_URL.
ALLOWED_ORIGINS=

# Registro público de empresas (/registro y POST /api/signup).
# Mantener en false: abrir cuando el aislamiento multi-tenant esté completo (fase 2).
REFICIO_SIGNUP_ENABLED=false

# Retención de bitácoras/notificaciones en días (purgas diarias del bot/cron).
# Opcionales: cada una tiene default y clamp en código
# (event-retention.ts / pending-signup-purge.ts / delegation-reconcile.ts).
AUDIT_RETENTION_DAYS=90
PLATFORM_RETENTION_DAYS=365
NOTIFICATION_RETENTION_DAYS=90
DIRECTORY_RETENTION_DAYS=180
SIGNUP_PENDING_PURGE_DAYS=30
PENDING_CUSTOMER_TTL_DAYS=30
DELEGATION_RECONCILE_STALE_DAYS=30

# Tope del pool pg de Prisma (default 20). Bajar si la instancia es chica.
PG_POOL_MAX=20

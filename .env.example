# Variables para DESARROLLO LOCAL (next dev / vitest / bot:dev).
# Copia a .env y rellena los valores. Para el despliegue Docker usa
# .env.docker.example — allí DATABASE_URL apunta al servicio `db` interno.

# PostgreSQL local (docker compose -f docker-compose.dev.yml up db, o tu instancia)
DATABASE_URL=postgresql://prosolutions:CAMBIAR@localhost:5432/prosolutions_db?schema=public

# Auth (next-auth v5). Generar: openssl rand -base64 32
NEXTAUTH_SECRET=CAMBIAR
# AUTH_SECRET es alias de NEXTAUTH_SECRET en los compose; en dev basta una.
AUTH_SECRET=CAMBIAR
NEXTAUTH_URL=http://localhost:3000

# Bot de Telegram (solo si corres el bot en dev: npm run bot:dev)
TELEGRAM_BOT_TOKEN=
# Username del bot sin @ para deep-links t.me/<bot>?start=verify_<código>;
# si se omite se resuelve con getMe al vuelo.
TELEGRAM_BOT_USERNAME=
# Archivo que el bot toca cada minuto como heartbeat (default /tmp/bot-alive;
# en Docker el healthcheck lo vigila). En dev casi nunca hace falta cambiarlo.
BOT_HEARTBEAT_FILE=/tmp/bot-alive

# Secreto compartido para los endpoints /api/cron/* y
# /api/reservations/check-expiring (Bearer). Obligatorio en producción.
CRON_SECRET=CAMBIAR

# Directorio de comprobantes de pago privados (default <repo>/storage/payment-proofs)
PAYMENT_PROOFS_DIR=
# Directorio de evidencias de reparación (default <repo>/data/uploads)
REPAIR_EVIDENCE_DIR=

# Cifrado del PIN/patrón de equipos (AES-256-GCM): openssl rand -hex 32.
# Si se omite se deriva de NEXTAUTH_SECRET.
DEVICE_SECRET_KEY=

# Correo transaccional (Resend) para códigos de verificación de altas.
# Vacío = sin verificación por correo (solo Telegram puede activar).
RESEND_API_KEY=
RESEND_FROM="Reficio <noreply@resend.dev>"

# Notificaciones push web (opcional): web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@prosolutions.com

# Orígenes extra permitidos para requests mutadores (lista separada por
# comas). En dev normalmente vacío: el propio host ya está permitido.
ALLOWED_ORIGINS=

# IP real detrás de un proxy que fije CF-Connecting-IP / X-Forwarded-For.
# Dejar ausente/false en desarrollo (los compose de producción la fijan).
TRUST_PROXY_HEADERS=

# Registro público de empresas (/registro y POST /api/signup)
REFICIO_SIGNUP_ENABLED=false

# Retención en días de bitácoras/notificaciones (purgas; opcional, hay defaults)
AUDIT_RETENTION_DAYS=90
PLATFORM_RETENTION_DAYS=365
NOTIFICATION_RETENTION_DAYS=90
DIRECTORY_RETENTION_DAYS=180
SIGNUP_PENDING_PURGE_DAYS=30
PENDING_CUSTOMER_TTL_DAYS=30
DELEGATION_RECONCILE_STALE_DAYS=30

# Tope del pool pg de Prisma (default 20)
PG_POOL_MAX=20

# --- Solo tests ---
# RUN_DATABASE_TESTS=1 habilita los *.integration.test.ts (requieren la BD
# de hardening corriendo; el proyecto unit de vitest no los necesita).
RUN_DATABASE_TESTS=
